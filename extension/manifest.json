{
  "manifest_version": 3,
  "name": "YT Drop — yt-dlp downloader",
  "version": "1.4.0",
  "description": "Download a YouTube video or audio with your local yt-dlp helper.",
  "minimum_chrome_version": "105",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Drop"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
